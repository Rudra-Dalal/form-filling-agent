# Anthropic Claude API Key for Document Extraction and Form-Filling Reasoning
ANTHROPIC_API_KEY=sk-ant-api03-...

# FastAPI Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Playwright Browser Configuration
# false: visible browser window for user observation and human review
# true: headless browser (useful in automated test environments)
HEADLESS=false

# Agent Autonomous Loop Safety Configuration
AGENT_MAX_ITERATIONS=35
AGENT_ACTION_TIMEOUT=30000
AGENT_MAX_RETRIES=3
